{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EveryFile",
  "mainBinaryName": "EveryFile",
  "version": "1.0.0",
  "identifier": "com.cybereun.everyfile",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EveryFile",
        "width": 800,
        "height": 600,
        "minWidth": 720,
        "minHeight": 520,
        "devtools": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Lebi_Cybereun",
    "copyright": "\u00A9 2026 Lebi_Cybereun",
    "externalBin": [
      "binaries/everyfile-parser",
      "binaries/everyfile-ocr"
    ],
    "targets": ["nsis"],
    "category": "Productivity",
    "shortDescription": "Local-first document search for Windows",
    "longDescription": "EveryFile indexes and searches user-selected folders on this PC. Core indexing and search do not upload documents.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean", "English"],
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
