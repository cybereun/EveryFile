{
  "name": "everyfile",
  "private": true,
  "version": "1.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "build:e2e": "powershell -ExecutionPolicy Bypass -File scripts/build-e2e.ps1",
    "test:e2e": "npm run build:e2e && wdio run wdio.conf.ts",
    "tauri": "tauri",
    "release:windows": "powershell -ExecutionPolicy Bypass -File scripts/release-windows.ps1",
    "package:portable": "powershell -ExecutionPolicy Bypass -File scripts/build-portable.ps1",
    "generate:update-manifest": "node scripts/generate-update-manifest.mjs",
    "verify:no-console": "powershell -ExecutionPolicy Bypass -File scripts/verify-no-console.ps1"
  },
  "dependencies": {
    "@rhwp/core": "0.7.19",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@wdio/cli": "9.30.0",
    "@wdio/globals": "9.29.1",
    "@wdio/local-runner": "9.30.0",
    "@wdio/mocha-framework": "9.30.0",
    "@wdio/tauri-plugin": "1.2.0",
    "@wdio/tauri-service": "1.2.0",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "webdriverio": "9.30.0"
  },
  "overrides": {
    "@wdio/native-utils": "2.5.0"
  }
}
